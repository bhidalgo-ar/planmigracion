{
  "name": "plan-simulador",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:duraciones && npm run test:migracion && npm run test:reglas && npm run test:equipo && npm run test:confidencial && npm run test:importar && npm run test:resumen && npm run test:planificador && npm run test:vacaciones && npm run test:reasignacion",
    "test:reasignacion": "esbuild test/reasignacion.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-reasignacion.mjs --log-level=warning && node dist/.test-reasignacion.mjs",
    "test:vacaciones": "esbuild test/vacaciones.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-vacaciones.mjs --log-level=warning && node dist/.test-vacaciones.mjs",
    "test:planificador": "esbuild test/planificador.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-planificador.mjs --log-level=warning && node dist/.test-planificador.mjs",
    "test:duraciones": "esbuild test/duraciones.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-duraciones.mjs --log-level=warning && node dist/.test-duraciones.mjs",
    "test:migracion": "esbuild test/migracion.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-migracion.mjs --log-level=warning && node dist/.test-migracion.mjs",
    "test:reglas": "esbuild test/reglas.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-reglas.mjs --log-level=warning && node dist/.test-reglas.mjs",
    "test:equipo": "esbuild test/equipo.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-equipo.mjs --log-level=warning && node dist/.test-equipo.mjs",
    "test:confidencial": "esbuild test/confidencial.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-confidencial.mjs --log-level=warning && node dist/.test-confidencial.mjs",
    "test:importar": "esbuild test/importar.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-importar.mjs --log-level=warning && node dist/.test-importar.mjs",
    "test:resumen": "esbuild test/resumen.test.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=dist/.test-resumen.mjs --log-level=warning && node dist/.test-resumen.mjs"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.4"
  }
}
